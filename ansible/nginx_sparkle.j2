# Managed by Ansible — do not edit on the server.
# Mirrors the production Nginx config in docs/DEPLOYMENT_LOG.md Phase 5.

server {
    listen 80;
    server_name {{ server_name }};

    location / {
        proxy_pass http://127.0.0.1:{{ app_port }};

        # Preserve the real client and protocol. Without these the app
        # sees every request as coming from 127.0.0.1 over plain HTTP,
        # which breaks logging and can break redirects.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
